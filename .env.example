# ---- App ----
SECRET_KEY=change-this-to-a-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Local dev default. In production (e.g. Vercel), SQLite's local file storage
# does not persist across serverless invocations -- set this to a hosted
# Postgres URL instead (Vercel Postgres, Neon, Supabase, etc.), e.g.:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./karmayogi_compass.db

# Comma-separated list of allowed frontend origins for CORS. Leave as * only
# for local dev -- set this to your real deployed origin(s) in production.
CORS_ORIGINS=*

# ---- iGOT Adapter ----
# "mock" uses bundled structured JSON fixtures, "live" calls real iGOT endpoints
IGOT_MODE=mock
IGOT_BASE_URL=https://igot.gov.in/api
IGOT_API_KEY=

# ---- LLM (used via LiteLLM) ----
LLM_PROVIDER=gemini
LLM_MODEL=gemini/gemini-3.6-flash
GEMINI_API_KEY=
