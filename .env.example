# ---- App ----
SECRET_KEY=change-this-to-a-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Local dev default. In production (Vercel), SQLite doesn't work: the bundle is
# read-only and /tmp is wiped on every cold start. Use Neon Postgres instead.
#
# Paste the POOLED connection string from the Neon dashboard -- the host ends in
# "-pooler". Serverless functions open a connection per request, so the pooled
# endpoint (PgBouncer) is what keeps you under Neon's connection limit.
#
# DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
#
# A "postgres://" prefix is normalised to "postgresql+psycopg2://" automatically,
# and sslmode=require is added if missing. If DATABASE_URL is left at the SQLite
# default, POSTGRES_URL / DATABASE_URL_UNPOOLED are picked up instead, so the
# Vercel/Neon integration works without editing this file.
DATABASE_URL=sqlite:///./karmayogi_compass.db

# Comma-separated list of allowed frontend origins for CORS. Leave as * only
# for local dev -- set this to your real deployed origin(s) in production.
CORS_ORIGINS=*

# ---- iGOT Adapter ----
# "mock" uses bundled structured JSON fixtures, "live" calls real iGOT endpoints
IGOT_MODE=mock
IGOT_BASE_URL=https://igot.gov.in/api
IGOT_API_KEY=

# ---- LLM (used via LiteLLM) ----
LLM_PROVIDER=gemini
LLM_MODEL=gemini/gemini-3.6-flash
GEMINI_API_KEY=
