# ---- App ----
SECRET_KEY=change-this-to-a-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=120
DATABASE_URL=sqlite:///./karmayogi_compass.db

# ---- iGOT Adapter ----
# "mock" uses bundled structured JSON fixtures, "live" calls real iGOT endpoints
IGOT_MODE=mock
IGOT_BASE_URL=https://igot.gov.in/api
IGOT_API_KEY=

# ---- LLM (used via LiteLLM) ----
LLM_PROVIDER=gemini
LLM_MODEL=gemini/gemini-1.5-flash
GEMINI_API_KEY=
